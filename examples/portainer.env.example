# ZockArchive Portainer Stack environment template
# Copy these values into Portainer's stack environment section.
# Do not commit a filled copy. Generate secrets with:
#   openssl rand -hex 32

# 1. General application settings
PGDP_PROJECT_NAME=pgdp
# Tag for the image built from this Git checkout. Change only for an intentional
# compatible prebuilt image deployment.
PGDP_IMAGE=pc-game-download-portal:portainer
PGDP_CONTAINER_NAME=pgdp
PGDP_DB_CONTAINER_NAME=pgdp-db
PGDP_TZ=UTC

# 2. Network and port
# Host-side port only. The container always listens on 8080.
PGDP_HTTP_PORT=8080

# 3. NAS directories
# These are examples, not universal defaults. The paths must exist on the host
# where the Docker daemon runs, not only on an administrator workstation.
# Synology examples:
# PGDP_LIBRARY_PATH=/volume1/Games
# PGDP_ASSETS_PATH=/volume1/docker/pc-downloadportal/assets
# PGDP_CONFIG_PATH=/volume1/docker/pc-downloadportal/config
#
# QNAP and Linux use the paths configured on those hosts, for example a mounted
# share or an administrator-owned directory. Do not copy these examples blindly.
PGDP_LIBRARY_PATH=/srv/pgdp/library
PGDP_ASSETS_PATH=/srv/pgdp/assets
PGDP_CONFIG_PATH=/srv/pgdp/config

# The library path is mounted read-only. Assets and config must be writable by
# the container's application user. A wrong path or permission causes an empty library,
# mount failure, or startup error.

# 4. Database
PGDP_DB_NAME=pgdp
PGDP_DB_USER=pgdp-user
# Required. Use a unique long value.
PGDP_DB_PASSWORD=replace-with-a-long-random-password
# Required. Use a different unique long value from PGDP_DB_PASSWORD.
PGDP_DB_ROOT_PASSWORD=replace-with-a-different-long-random-password

# 5. Security
# Required. Generate a long random value, for example:
#   openssl rand -hex 32
PGDP_AUTH_SECRET_KEY=replace-with-openssl-rand-hex-32

# 6. Optional metadata providers
# Leave blank when a provider is not configured. The application still starts,
# but metadata or cover search from that provider remains unavailable.
PGDP_SCREENSCRAPER_USER=
PGDP_SCREENSCRAPER_PASSWORD=
# Required only when this Git stack builds the image from source. Keep these
# application credentials in Portainer or a secret store and never commit them.
PGDP_SCREENSCRAPER_DEV_ID=
PGDP_SCREENSCRAPER_DEV_PASSWORD=
PGDP_RETROACHIEVEMENTS_API_KEY=
# SteamGridDB: API key from your SteamGridDB account/API page.
PGDP_STEAMGRIDDB_API_KEY=
# IGDB: Client ID and Client Secret from a Twitch Developer application.
PGDP_IGDB_CLIENT_ID=
PGDP_IGDB_CLIENT_SECRET=
PGDP_HASHEOUS_API_ENABLED=true
